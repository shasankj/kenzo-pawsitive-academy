# Copy to .env.local (dev) or set in CI (prod). VITE_* values are public; never put secrets here.

# Required for `npm run build`: API Gateway invoke URL including the stage.
VITE_API_BASE=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>

# Dev only: target for the Vite /api proxy (host + stage). Leave VITE_API_BASE unset in dev to use it.
VITE_DEV_API_TARGET=https://<api-id>.execute-api.<region>.amazonaws.com/development
